<%@ include file="/fragments/header.jspf" %><section class="form-page"><div class="section-eyebrow">A FEW GOOD CHOICES</div><div class="section-heading"><h1>${messages.getString('bag')}<span class="teal">.</span></h1><a href="${ctx}/products" class="text-link">Keep exploring ↗</a></div><c:choose><c:when test="${empty cart}"><div class="empty-state"><div class="empty-icon">♧</div><h2>Room for something good.</h2><p>Your bag is waiting for its first find.</p><a class="button dark" href="${ctx}/products">Explore the collection ↗</a></div></c:when><c:otherwise><div class="checkout-layout"><div><c:forEach var="item" items="${cart}"><article class="cart-item"><a href="${ctx}/product?id=${item.id}"><img src="${ctx}${item.image_url}" alt="${fn:escapeXml(item.name)}"></a><div class="cart-item-copy"><small class="section-eyebrow"><c:out value="${item.brand}"/></small><h3><a href="${ctx}/product?id=${item.id}"><c:out value="${fn:escapeXml(item.name)}"/></a></h3><p>₹<fmt:formatNumber value="${item.sale_price}" minFractionDigits="2" maxFractionDigits="2"/> each</p><form method="post" action="${ctx}/cart" class="inline-form"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="product" value="${item.id}"><label>Qty <input class="quantity" aria-label="Quantity of ${fn:escapeXml(item.name)}" type="number" name="quantity" min="0" max="99" value="${item.quantity}"></label><button class="text-button">Update</button><button class="text-button muted" name="quantity" value="0" formaction="${ctx}/cart" type="button" data-remove="true">Remove</button></form></div><strong>₹<fmt:formatNumber value="${item.line_total}" minFractionDigits="2" maxFractionDigits="2"/></strong></article></c:forEach></div><aside class="panel summary"><h2>The good stuff</h2><div class="summary-line"><span>Subtotal</span><span>₹<fmt:formatNumber value="${subtotal}" minFractionDigits="2" maxFractionDigits="2"/></span></div><div class="summary-line"><span>Shipping</span><span class="teal">On the house</span></div><div class="summary-line total"><strong>Total</strong><strong>₹<fmt:formatNumber value="${subtotal}" minFractionDigits="2" maxFractionDigits="2"/></strong></div><a class="button dark full" href="${ctx}/checkout">Continue to checkout ↗</a><p class="muted small">Have a coupon? Apply it at checkout.<br>Try WELCOME10 for 10% off orders over ₹1,000 (up to ₹1,000).</p><p class="secure-note">◇ Secure checkout · Simulated payments</p></aside></div></c:otherwise></c:choose></section><%@ include file="/fragments/footer.jspf" %>
