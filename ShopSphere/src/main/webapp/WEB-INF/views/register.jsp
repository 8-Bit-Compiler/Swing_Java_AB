<%@ include file="/fragments/header.jspf" %><section class="form-page narrow"><div class="section-eyebrow">NICE TO MEET YOU</div><h1>Your everyday, upgraded.</h1><p class="muted">A few details, and you're part of the sphere.</p><form class="stack panel" method="post" action="${ctx}/register"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><label>Full name<input name="name" minlength="2" maxlength="100" required autocomplete="name"></label><label>Email address<input type="email" name="email" maxlength="190" required autocomplete="email"></label><label>Password<input type="password" name="password" minlength="8" maxlength="128" required autocomplete="new-password"><small>At least 8 characters.</small></label><button class="button dark full">Create account ↗</button></form><p>Already part of the sphere? <a href="${ctx}/login" class="text-link">Sign in</a></p></section><%@ include file="/fragments/footer.jspf" %>
