<%@ include file="/fragments/header.jspf" %><section class="form-page"><%@ include file="/fragments/admin-nav.jspf" %><div class="stats-grid"><div class="panel"><small class="section-eyebrow">TOTAL SALES</small><h2>₹<fmt:formatNumber value="${stats.revenue}" minFractionDigits="2" maxFractionDigits="2"/></h2><span class="muted">Excludes cancelled orders</span></div><div class="panel"><small class="section-eyebrow">ORDERS</small><h2>${stats.orders}</h2><a href="${ctx}/admin/orders" class="text-link">Manage orders ↗</a></div><div class="panel"><small class="section-eyebrow">PRODUCTS</small><h2>${stats.products}</h2><a href="${ctx}/admin/products" class="text-link">Manage collection ↗</a></div><div class="panel"><small class="section-eyebrow">ACCOUNTS</small><h2>${stats.users}</h2><a href="${ctx}/admin/users" class="text-link">View customers ↗</a></div></div><div class="two-columns"><section class="panel"><h2>Recent orders</h2><c:if test="${empty recentOrders}"><p class="muted">Orders will appear here as your store grows.</p></c:if><c:forEach var="order" items="${recentOrders}"><a class="summary-line" href="${ctx}/order?id=${order.id}"><span>#SS-${order.id} · <c:out value="${order.name}"/></span><strong>₹<fmt:formatNumber value="${order.total_amount}" minFractionDigits="2" maxFractionDigits="2"/></strong><span class="status">${order.order_status}</span></a></c:forEach></section><section class="panel"><h2>A little stock check</h2><p class="muted">Products with fewer than 10 units remaining.</p><c:if test="${empty stats.low_stock}"><p>All stocked up. Looking good.</p></c:if><c:forEach var="product" items="${stats.low_stock}"><a href="${ctx}/admin/products?edit=${product.id}" class="summary-line"><span><c:out value="${fn:escapeXml(product.name)}"/></span><span class="status">${product.stock} left ↗</span></a></c:forEach></section></div></section><%@ include file="/fragments/footer.jspf" %>
