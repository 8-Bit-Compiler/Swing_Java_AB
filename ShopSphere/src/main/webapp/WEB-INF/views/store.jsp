<%@ include file="/fragments/header.jspf" %>
<c:if test="${empty param.q && empty param.category}"><section class="hero"><div class="hero-copy"><div class="eyebrow"><span class="tiny-dot"></span> THE EVERYDAY EDIT / 2026</div><h1>${messages.getString('welcome')}</h1><p>Discover essentials that bring a little more<br class="desktop-only"> joy to your everyday. Less clutter. More character.</p><a class="button dark" href="#collection">${messages.getString('shop')} <span>↗</span></a><div class="hero-proof"><span class="mini-stars">★★★★★</span><span>Small details. A better everyday.</span></div></div><div class="hero-art"><img src="${ctx}/assets/hero.svg" alt="A curated collection of headphones, a ceramic cup and desk accessories"><div class="hero-caption"><span class="tiny-dot"></span> GOOD DESIGN. GREAT COMPANY.</div><span class="hero-index">01 / THE CURATED COLLECTION</span></div></section><div class="benefits"><div><span class="benefit-icon">↗</span><span><strong>On the house</strong><small>Free shipping, every time</small></span></div><div><span class="benefit-icon">◎</span><span><strong>Made for real life</strong><small>Useful, beautiful, thoughtfully chosen</small></span></div><div><span class="benefit-icon">↶</span><span><strong>A considered collection</strong><small>Fewer things. Better choices.</small></span></div><div><span class="benefit-icon">◇</span><span><strong>A little peace of mind</strong><small>Simple, secure shopping</small></span></div></div></c:if>
<section class="collection" id="collection"><div class="section-heading"><div><div class="section-eyebrow">FIND YOUR NEXT EVERYDAY FAVOURITE</div><h2>${empty param.q && empty param.category ? 'Good finds. Great company' : 'The collection'}<span class="teal">.</span></h2></div><span class="muted">${fn:length(products)} thoughtful finds</span></div>
<form class="catalog-toolbar" method="get" action="${ctx}/products"><div class="category-pills"><a class="pill ${empty param.category ? 'active' : ''}" href="${ctx}/products#collection">All finds</a><c:forEach var="cat" items="${categories}"><c:if test="${cat.status}"><a class="pill ${param.category == cat.id ? 'active' : ''}" href="${ctx}/products?category=${cat.id}#collection"><c:out value="${cat.name}"/></a></c:if></c:forEach></div><div class="catalog-controls"><input type="hidden" name="category" value="${fn:escapeXml(param.category)}"><div class="search-box"><span>⌕</span><input name="q" value="${fn:escapeXml(param.q)}" placeholder="Find your thing…" aria-label="Search products"><button aria-label="Search">↵</button></div><select name="sort" aria-label="Sort products" class="auto-submit"><option value="">Sort: Featured</option><option value="price-low" ${param.sort == 'price-low' ? 'selected' : ''}>Price: Low to high</option><option value="price-high" ${param.sort == 'price-high' ? 'selected' : ''}>Price: High to low</option><option value="name" ${param.sort == 'name' ? 'selected' : ''}>Name: A–Z</option></select><noscript><button class="button">Apply</button></noscript></div></form>
<c:choose><c:when test="${empty products}"><div class="empty-state"><div class="empty-icon">⌕</div><h2>No finds just yet.</h2><p>Try a different search or explore the full collection.</p><a class="button dark" href="${ctx}/products">See all products ↗</a></div></c:when><c:otherwise><div class="product-grid"><c:forEach var="product" items="${products}"><shop:productCard product="${product}"/></c:forEach></div></c:otherwise></c:choose></section>
<section class="editorial"><span class="section-eyebrow">A LITTLE LESS, A LITTLE BETTER</span><h2>Make room for the things<br>that make your day.</h2><p>Objects with a purpose. Details with a point of view.<br>Welcome to a more considered everyday.</p><a href="${ctx}/products?category=4" class="text-link">Explore lifestyle ↗</a><span class="editorial-orbit" aria-hidden="true">s.</span></section>
<%@ include file="/fragments/footer.jspf" %>
