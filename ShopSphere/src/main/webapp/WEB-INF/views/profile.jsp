<%@ include file="/fragments/header.jspf" %><section class="form-page"><div class="section-eyebrow">YOUR CORNER OF THE SPHERE</div><div class="section-heading"><h1>Hello, <c:out value="${sessionScope.user.name}"/><span class="teal">.</span></h1><form method="post" action="${ctx}/logout"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button class="button light">Sign out ↗</button></form></div><div class="two-columns"><div><form method="post" class="panel stack" action="${ctx}/profile"><h2>A little about you</h2><input type="hidden" name="csrf" value="${sessionScope.csrf}"><label>Name<input name="name" value="${fn:escapeXml(sessionScope.user.name)}" required minlength="2" maxlength="100"></label><label>Email<input value="${fn:escapeXml(sessionScope.user.email)}" readonly></label><label>Mobile<input name="mobile" value="${fn:escapeXml(sessionScope.user.mobile)}" maxlength="20"></label><button class="button dark">Save details ↗</button><div class="inline-links"><a href="${ctx}/orders">My orders</a><a href="${ctx}/wishlist">Saved items</a><c:if test="${sessionScope.user.role == 'ADMIN'}"><a href="${ctx}/admin">Manage store</a></c:if></div></form></div><div><section class="panel"><h2>Your saved addresses</h2><c:if test="${empty addresses}"><p class="muted">Add your first delivery address below.</p></c:if><c:forEach var="address" items="${addresses}"><div class="address-card"><strong><c:out value="${address.address_type}"/></strong><p><c:out value="${address.address_line}"/><br><c:out value="${address.city}"/>, <c:out value="${address.state}"/> ${address.pincode}</p><form action="${ctx}/profile" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="delete-address"><input type="hidden" name="id" value="${address.id}"><button class="text-button">Remove address</button></form></div></c:forEach><details open><summary>Add an address</summary><%@ include file="/fragments/address-form.jspf" %></details></section></div></div></section><%@ include file="/fragments/footer.jspf" %>
