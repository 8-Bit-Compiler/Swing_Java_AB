<%@ include file="/fragments/header.jspf" %><section class="form-page"><div class="section-eyebrow">YOUR FINDS, ON THEIR WAY</div><h1>A little order history<span class="teal">.</span></h1><c:if test="${empty orders}"><div class="empty-state"><h2>Your story starts with a good find.</h2><p>You'll find your orders and tracking details here.</p><a class="button dark" href="${ctx}/products">Explore ↗</a></div></c:if><c:forEach var="order" items="${orders}"><a class="order-card panel" href="${ctx}/order?id=${order.id}"><div><small class="section-eyebrow">ORDER #SS-${order.id}</small><h3>₹<fmt:formatNumber value="${order.total_amount}" minFractionDigits="2" maxFractionDigits="2"/></h3><span class="muted small">${order.created_at}</span></div><div><span class="status">${order.order_status}</span><p class="small muted">View details ↗</p></div></a></c:forEach></section><%@ include file="/fragments/footer.jspf" %>
