<%@ include file="/fragments/header.jspf" %><section class="form-page"><div class="section-eyebrow">THE LAST LITTLE STEP</div><h1>Almost yours<span class="teal">.</span></h1><div class="checkout-layout"><div><section class="panel"><h2>01 / Where should it go?</h2><c:choose><c:when test="${empty addresses}"><p class="muted">Save a delivery address to continue.</p><%@ include file="/fragments/address-form.jspf" %></c:when><c:otherwise><c:forEach var="address" items="${addresses}"><label class="address-option"><input type="radio" form="checkout-form" name="address" value="${address.id}" required><span><strong><c:out value="${address.address_type}"/></strong><br><c:out value="${address.address_line}"/><br><c:out value="${address.city}"/>, <c:out value="${address.state}"/> ${address.pincode}</span></label></c:forEach><details><summary>Add another address</summary><%@ include file="/fragments/address-form.jspf" %></details></c:otherwise></c:choose></section><form class="panel stack" id="checkout-form" method="post" action="${ctx}/checkout"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="token" value="${sessionScope.checkoutToken}"><h2>02 / The finishing touch</h2><label>Coupon code <span class="muted">(optional)</span><input name="coupon" maxlength="30" placeholder="WELCOME10"></label><small class="muted">WELCOME10: 10% off ₹1,000+, up to ₹1,000. One use per customer. Final total is calculated when you place your order.</small><h2>03 / How would you like to pay?</h2><label class="payment-choice"><input type="radio" name="payment" value="MOCK_CARD" checked> Mock card · simulated payment</label><label class="payment-choice"><input type="radio" name="payment" value="COD"> Cash on delivery</label><label>Mock card outcome<select name="mock_result"><option value="success">Approve payment</option><option value="decline">Decline payment (test rollback)</option></select></label><p class="muted small">This is an educational store. No card details or real payment are collected.</p><button class="button dark full" ${empty addresses ? 'disabled' : ''}>Place order <span>↗</span></button></form></div><aside class="panel summary"><h2>Your good finds</h2><c:forEach var="item" items="${cart}"><div class="checkout-item"><img src="${ctx}${item.image_url}" alt=""><div><strong><c:out value="${fn:escapeXml(item.name)}"/></strong><small>Qty ${item.quantity}</small></div><span>₹<fmt:formatNumber value="${item.line_total}" minFractionDigits="2" maxFractionDigits="2"/></span></div></c:forEach><div class="summary-line"><span>Subtotal</span><strong>₹<fmt:formatNumber value="${subtotal}" minFractionDigits="2" maxFractionDigits="2"/></strong></div><div class="summary-line"><span>Shipping</span><span class="teal">Free</span></div><p class="muted small">Coupon discount appears in your order confirmation.</p><a class="text-link" href="${ctx}/cart">← Edit bag</a></aside></div></section><%@ include file="/fragments/footer.jspf" %>
