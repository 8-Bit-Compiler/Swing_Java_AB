<%@ include file="/fragments/header.jspf" %><section class="form-page"><a href="${ctx}/orders" class="text-link">← Your orders</a><div class="section-heading"><div><div class="section-eyebrow">A GOOD FIND, CONFIRMED</div><h1>Order #SS-${order.id}<span class="teal">.</span></h1><p class="muted">Placed ${order.created_at}</p></div><span class="status">${order.order_status}</span></div><div class="timeline"><c:forEach var="step" items="${['PLACED','PROCESSING','SHIPPED','DELIVERED']}"><div class="${order.order_status == step ? 'current' : ''}"><span>●</span>${step}</div></c:forEach></div><c:if test="${order.order_status == 'CANCELLED'}"><div class="notice">Order cancelled. Inventory has been restored. Paid mock payments are marked refunded.</div></c:if><div class="checkout-layout"><section class="panel"><h2>Here's what you picked</h2><c:forEach var="item" items="${items}"><div class="summary-line"><div><strong><c:out value="${item.product_name}"/></strong><p class="small muted">${item.quantity} × ₹<fmt:formatNumber value="${item.price}" minFractionDigits="2" maxFractionDigits="2"/></p></div><strong>₹<fmt:formatNumber value="${item.price * item.quantity}" minFractionDigits="2" maxFractionDigits="2"/></strong></div></c:forEach><hr><h3>Heading to</h3><p><c:out value="${order.shipping_address}"/></p></section><aside class="panel summary"><h2>All the details</h2><div class="summary-line"><span>Subtotal</span><span>₹<fmt:formatNumber value="${order.subtotal}" minFractionDigits="2" maxFractionDigits="2"/></span></div><div class="summary-line"><span>Coupon savings</span><span>−₹<fmt:formatNumber value="${order.discount}" minFractionDigits="2" maxFractionDigits="2"/></span></div><div class="summary-line"><span>Shipping</span><span class="teal">Free</span></div><div class="summary-line total"><strong>Total</strong><strong>₹<fmt:formatNumber value="${order.total_amount}" minFractionDigits="2" maxFractionDigits="2"/></strong></div><p class="small muted">${order.payment_method} · ${order.payment_status}</p><a href="${ctx}/products" class="button dark full">More good finds ↗</a></aside></div></section><%@ include file="/fragments/footer.jspf" %>
