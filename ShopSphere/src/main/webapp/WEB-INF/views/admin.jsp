<%@ include file="/fragments/header.jspf" %><section class="form-page"><%@ include file="/fragments/admin-nav.jspf" %>
<c:choose><c:when test="${section == 'products'}"><div class="section-heading"><h2>The collection</h2><span class="muted">${fn:length(rows)} products · Archive to remove from the storefront</span></div><details class="panel" ${not empty edit ? 'open' : ''}><summary>${empty edit ? '＋ Add a product' : 'Edit product'}</summary><form class="stack" method="post" action="${ctx}/admin/products"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${empty edit ? 0 : edit.id}"><div class="two-columns"><label>Product name<input name="name" required maxlength="150" value="${fn:escapeXml(edit.name)}"></label><label>Brand<input name="brand" required maxlength="100" value="${fn:escapeXml(edit.brand)}"></label></div><label>Description<textarea name="description" required minlength="5" maxlength="2000" rows="3"><c:out value="${edit.description}"/></textarea></label><div class="form-grid"><label>Category<select name="category"><c:forEach var="cat" items="${categories}"><option value="${cat.id}" ${edit.category_id == cat.id ? 'selected' : ''}><c:out value="${cat.name}"/></option></c:forEach></select></label><label>Price (₹)<input name="price" type="number" step="0.01" min="0.01" max="99999999" required value="${edit.price}"></label><label>Discount (%)<input name="discount" type="number" step="0.01" min="0" max="99.99" required value="${empty edit ? 0 : edit.discount}"></label><label>Stock<input name="stock" type="number" min="0" max="1000000" required value="${empty edit ? 0 : edit.stock}"></label></div><label>Product illustration<select name="image"><c:forEach var="image" items="${['headphones','lamp','backpack','speaker','keyboard','cup','watch','bottle']}"><option value="/assets/${image}.svg" ${edit.image_url == '/assets/'.concat(image).concat('.svg') ? 'selected' : ''}>${image}</option></c:forEach></select></label><label class="checkbox"><input type="checkbox" name="active" ${empty edit || edit.status ? 'checked' : ''}> Available in storefront</label><div class="inline-links"><button class="button dark">Save product ↗</button><a href="${ctx}/admin/products">Cancel</a></div></form></details><div class="table-wrap"><table><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th>Manage</th></tr></thead><tbody><c:forEach var="item" items="${rows}"><tr><td><div class="table-product"><img src="${ctx}${item.image_url}" alt=""><div><strong><c:out value="${fn:escapeXml(item.name)}"/></strong><small><c:out value="${item.brand}"/></small></div></div></td><td><c:out value="${item.category}"/></td><td>₹<fmt:formatNumber value="${item.sale_price}" minFractionDigits="2" maxFractionDigits="2"/></td><td>${item.stock}</td><td><span class="status">${item.status ? 'Active' : 'Archived'}</span></td><td><a class="text-link" href="${ctx}/admin/products?edit=${item.id}">Edit ↗</a></td></tr></c:forEach></tbody></table></div></c:when>
<c:when test="${section == 'categories'}"><h2>Make room for more.</h2><details class="panel" ${not empty edit ? 'open' : ''}><summary>${empty edit ? '＋ Add category' : 'Edit category'}</summary><form class="stack" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${empty edit ? 0 : edit.id}"><label>Name<input name="name" required minlength="2" maxlength="100" value="${fn:escapeXml(edit.name)}"></label><label>Description<textarea name="description" maxlength="500"><c:out value="${edit.description}"/></textarea></label><label class="checkbox"><input type="checkbox" name="active" ${empty edit || edit.status ? 'checked' : ''}> Active (archiving also hides its products)</label><button class="button dark">Save category ↗</button></form></details><div class="table-wrap"><table><thead><tr><th>Name</th><th>Description</th><th>Status</th><th>Manage</th></tr></thead><tbody><c:forEach var="item" items="${rows}"><tr><td><c:out value="${fn:escapeXml(item.name)}"/></td><td><c:out value="${item.description}"/></td><td>${item.status ? 'Active' : 'Archived'}</td><td><a href="${ctx}/admin/categories?edit=${item.id}" class="text-link">Edit ↗</a></td></tr></c:forEach></tbody></table></div></c:when>
<c:when test="${section == 'orders'}"><h2>Good finds in motion.</h2><p class="muted">Placed → Processing → Shipped → Delivered. Cancel before shipping to restore stock and simulate a refund.</p><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Payment</th><th>Status</th><th>Next step</th></tr></thead><tbody><c:forEach var="item" items="${rows}"><tr><td><a class="text-link" href="${ctx}/order?id=${item.id}">#SS-${item.id} ↗</a></td><td><c:out value="${fn:escapeXml(item.name)}"/><small><c:out value="${item.email}"/></small></td><td>₹<fmt:formatNumber value="${item.total_amount}" minFractionDigits="2" maxFractionDigits="2"/></td><td>${item.payment_status}</td><td><span class="status">${item.order_status}</span></td><td><c:if test="${item.order_status != 'DELIVERED' && item.order_status != 'CANCELLED'}"><form class="inline-form" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${item.id}"><select name="status" aria-label="Next order status"><c:if test="${item.order_status == 'PLACED'}"><option>PROCESSING</option></c:if><c:if test="${item.order_status == 'PROCESSING'}"><option>SHIPPED</option></c:if><c:if test="${item.order_status == 'SHIPPED'}"><option>DELIVERED</option></c:if><c:if test="${item.order_status == 'PLACED' || item.order_status == 'PROCESSING'}"><option>CANCELLED</option></c:if></select><button class="text-button">Update ↗</button></form></c:if></td></tr></c:forEach></tbody></table><c:if test="${empty rows}"><div class="empty-state">Your first order is just around the corner.</div></c:if></div></c:when>
<c:when test="${section == 'users'}"><h2>The people in your sphere.</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Mobile</th><th>Role</th><th>Status</th><th>Manage</th></tr></thead><tbody><c:forEach var="item" items="${rows}"><tr><td><c:out value="${fn:escapeXml(item.name)}"/></td><td><c:out value="${item.email}"/></td><td><c:out value="${item.mobile}"/></td><td>${item.role}</td><td><span class="status">${item.status ? 'Active' : 'Disabled'}</span></td><td><c:if test="${item.role == 'CUSTOMER'}"><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${item.id}"><input type="hidden" name="active" value="${!item.status}"><button class="text-button">${item.status ? 'Disable' : 'Enable'} account ↗</button></form></c:if></td></tr></c:forEach></tbody></table></div></c:when>
<c:when test="${section == 'coupons'}"><h2>A little something extra.</h2><details class="panel" ${not empty edit ? 'open' : ''}><summary>${empty edit ? '＋ Create coupon' : 'Edit coupon'}</summary><form method="post" class="stack"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${empty edit ? 0 : edit.id}"><div class="form-grid"><label>Code<input name="code" required minlength="3" maxlength="30" value="${fn:escapeXml(edit.code)}"></label><label>Type<select name="type"><option value="PERCENT">Percentage</option><option value="FIXED" ${edit.discount_type == 'FIXED' ? 'selected' : ''}>Fixed amount</option></select></label><label>Discount value<input name="value" type="number" step="0.01" min="0.01" required value="${edit.discount_value}"></label><label>Minimum spend (₹)<input name="minimum" type="number" step="0.01" min="0" required value="${empty edit ? 0 : edit.minimum_order}"></label><label>Maximum savings (₹)<input name="maximum" type="number" step="0.01" min="0.01" required value="${edit.maximum_discount}"></label><label>Expiry date<input name="expiry" type="date" required value="${edit.expiry_date}"></label></div><label class="checkbox"><input type="checkbox" name="active" ${empty edit || edit.status ? 'checked' : ''}> Active</label><button class="button dark">Save coupon ↗</button></form></details><div class="table-wrap"><table><thead><tr><th>Code</th><th>Discount</th><th>Minimum</th><th>Maximum</th><th>Expires</th><th>Status</th><th>Manage</th></tr></thead><tbody><c:forEach var="item" items="${rows}"><tr><td><strong><c:out value="${item.code}"/></strong></td><td>${item.discount_value} ${item.discount_type == 'PERCENT' ? '%' : 'INR'}</td><td>₹${item.minimum_order}</td><td>₹${item.maximum_discount}</td><td>${item.expiry_date}</td><td>${item.status ? 'Active' : 'Inactive'}</td><td><a class="text-link" href="${ctx}/admin/coupons?edit=${item.id}">Edit ↗</a></td></tr></c:forEach></tbody></table></div></c:when></c:choose></section><%@ include file="/fragments/footer.jspf" %>
