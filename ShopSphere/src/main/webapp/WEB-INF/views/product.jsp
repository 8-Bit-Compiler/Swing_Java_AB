<%@ include file="/fragments/header.jspf" %><div class="breadcrumbs"><a href="${ctx}/products">Collection</a><span>/</span><c:out value="${product.category}"/><span>/</span><c:out value="${fn:escapeXml(product.name)}"/></div><section class="product-detail"><div class="detail-visual"><img src="${ctx}${product.image_url}" alt="${fn:escapeXml(product.name)}"></div><div class="detail-copy"><div class="section-eyebrow"><c:out value="${product.brand}"/> / <c:out value="${product.category}"/></div><h1><c:out value="${fn:escapeXml(product.name)}"/></h1><p class="rating">★ ${empty product.rating ? 'New arrival' : product.rating} <span class="muted">(${product.review_count} reviews)</span></p><div class="prices detail-price"><strong>₹<fmt:formatNumber value="${product.sale_price}" minFractionDigits="2" maxFractionDigits="2"/></strong><c:if test="${product.discount > 0}"><del>₹<fmt:formatNumber value="${product.price}" minFractionDigits="2" maxFractionDigits="2"/></del><span class="inline-badge">Save <fmt:formatNumber value="${product.discount}" maxFractionDigits="0"/>%</span></c:if></div><p class="description"><c:out value="${product.description}"/></p><p class="stock-note"><span class="tiny-dot"></span> ${product.stock > 0 ? 'In stock, ready for your everyday' : 'Currently out of stock'} <c:if test="${product.stock > 0 && product.stock < 10}"> · Only ${product.stock} left</c:if></p><form class="buy-row" method="post" action="${ctx}/cart"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="product" value="${product.id}"><input type="hidden" name="action" value="add"><label class="sr-only" for="quantity">Quantity</label><input id="quantity" class="quantity" type="number" name="quantity" value="1" min="1" max="${product.stock < 99 ? product.stock : 99}"><button class="button dark full" ${product.stock == 0 ? 'disabled' : ''}>Add to bag <span>＋</span></button></form><form method="post" action="${ctx}/wishlist"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="product" value="${product.id}"><button class="button light full">♡ Save for later</button></form><div class="detail-perks"><span>↗ Free shipping</span><span>◇ Thoughtfully selected</span></div></div></section><section class="reviews-section"><div class="section-heading"><h2>From the community<span class="teal">.</span></h2><span class="muted">Real finds. Real experiences.</span></div><div class="two-columns"><div><c:if test="${empty reviews}"><div class="panel"><h3>A fresh find.</h3><p class="muted">Be the first to share a review after your order is delivered.</p></div></c:if><c:forEach var="review" items="${reviews}"><article class="panel review"><shop:rating value="${review.rating}"/><h3><c:out value="${review.name}"/></h3><p><c:out value="${review.review_text}"/></p><small class="muted">${review.created_at}</small></article></c:forEach></div><c:if test="${not empty sessionScope.user}"><form class="panel stack" method="post" action="${ctx}/review"><h3>Share your experience</h3><p class="muted">For customers with a delivered order.</p><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="product" value="${product.id}"><label>Your rating<select name="rating"><option value="5">★★★★★ · Loved it</option><option value="4">★★★★ · Great</option><option value="3">★★★ · Good</option><option value="2">★★ · Could be better</option><option value="1">★ · Not for me</option></select></label><label>Your review<textarea name="body" required minlength="5" maxlength="1500" rows="4"></textarea></label><button class="button dark">Post review ↗</button></form></c:if></div></section><c:if test="${not empty related}"><section class="collection"><h2>In good company.</h2><div class="product-grid"><c:forEach var="item" items="${related}"><shop:productCard product="${item}"/></c:forEach></div></section></c:if><%@ include file="/fragments/footer.jspf" %>
