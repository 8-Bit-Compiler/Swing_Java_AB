<%@ include file="/fragments/header.jspf" %><%@ taglib prefix="sql" uri="jakarta.tags.sql" %><section class="form-page"><a href="${ctx}/demo" class="text-link">← Java lab</a><h1>JSTL SQL, in isolation.</h1><sql:setDataSource var="labDb" driver="org.h2.Driver" url="jdbc:h2:mem:jstl_lab;DB_CLOSE_DELAY=-1" user="sa" password=""/><sql:query var="result" dataSource="${labDb}">SELECT 'Audio' AS category UNION ALL SELECT 'Workspace' UNION ALL SELECT 'Everyday'</sql:query><div class="panel"><p class="muted">A read-only query using an isolated H2 DataSource. The shopping application uses prepared statements in DAO classes.</p><ul><c:forEach var="row" items="${result.rows}"><li><c:out value="${row.category}"/></li></c:forEach></ul></div></section><%@ include file="/fragments/footer.jspf" %>
