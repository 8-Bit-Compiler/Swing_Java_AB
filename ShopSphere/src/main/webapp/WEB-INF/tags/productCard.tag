<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ tag pageEncoding="UTF-8" %><%@ attribute name="product" required="true" type="java.util.Map" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<article class="product-card"><div class="product-visual"><a href="${ctx}/product?id=${product.id}" aria-label="View ${fn:escapeXml(product.name)}"><img src="${ctx}${product.image_url}" alt="${fn:escapeXml(product.name)}" loading="lazy"></a><c:if test="${product.discount > 0}"><span class="sale-badge">−<fmt:formatNumber value="${product.discount}" maxFractionDigits="0"/>%</span></c:if><form method="post" action="${ctx}/wishlist" class="save-form"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="product" value="${product.id}"><button class="save-button" title="Toggle saved item" aria-label="Save ${fn:escapeXml(product.name)}">♡</button></form></div><div class="product-meta"><span><c:out value="${product.brand}"/></span><span class="rating">★ <c:choose><c:when test="${product.review_count > 0}">${product.rating} <span>(${product.review_count})</span></c:when><c:otherwise><span>New</span></c:otherwise></c:choose></span></div><h3><a href="${ctx}/product?id=${product.id}"><c:out value="${fn:escapeXml(product.name)}"/></a></h3><div class="product-bottom"><div class="prices"><strong>₹<fmt:formatNumber value="${product.sale_price}" maxFractionDigits="2" minFractionDigits="2"/></strong><c:if test="${product.discount > 0}"><del>₹<fmt:formatNumber value="${product.price}" maxFractionDigits="0"/></del></c:if></div><form method="post" action="${ctx}/cart"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="product" value="${product.id}"><input type="hidden" name="quantity" value="1"><input type="hidden" name="action" value="add"><button class="add-button" ${product.stock == 0 || !product.status ? 'disabled' : ''} aria-label="Add ${fn:escapeXml(product.name)} to bag">${product.stock == 0 || !product.status ? 'Sold out' : '+'}</button></form></div></article>
