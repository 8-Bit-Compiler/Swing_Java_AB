<%@ page pageEncoding="UTF-8" %>
<form class="stack" method="post" action="${ctx}/profile"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="address"><input type="hidden" name="return" value="${page}"><label>Street address<input name="address_line" required minlength="5" maxlength="300" autocomplete="street-address"></label><div class="two-columns"><label>City<input name="city" required minlength="2" maxlength="100" autocomplete="address-level2"></label><label>State<input name="state" required minlength="2" maxlength="100" autocomplete="address-level1"></label></div><div class="two-columns"><label>PIN code<input name="pincode" required pattern="[1-9][0-9]{5}" maxlength="6" autocomplete="postal-code"></label><label>Address type<select name="address_type"><option>Home</option><option>Work</option></select></label></div><button class="button dark">Save address ↗</button></form>
