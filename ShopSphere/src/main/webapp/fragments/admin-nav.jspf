<%@ page pageEncoding="UTF-8" %>
<div class="section-eyebrow">SHOPSPHERE MANAGEMENT</div><div class="admin-top"><h1>Your store, at a glance<span class="teal">.</span></h1><a class="button light" href="${ctx}/">View storefront ↗</a></div><nav class="admin-nav" aria-label="Administration"><a href="${ctx}/admin" class="${page == 'dashboard' ? 'active' : ''}">Overview</a><c:forEach var="tab" items="${['products','categories','orders','users','coupons']}"><a class="${section == tab ? 'active' : ''}" href="${ctx}/admin/${tab}">${fn:toUpperCase(fn:substring(tab,0,1))}${fn:substring(tab,1,fn:length(tab))}</a></c:forEach><a href="${ctx}/demo">Java lab ↗</a></nav>
