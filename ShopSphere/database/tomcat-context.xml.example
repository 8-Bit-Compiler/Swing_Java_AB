<!-- Optional JNDI resource for the admin-only /demo/jsp page.
     Place inside conf/Catalina/localhost/shopsphere.xml on standalone Tomcat.
     Put mysql-connector-j in Tomcat's lib directory for container-managed pools.
     Replace credentials and host with your local database configuration. -->
<Context>
 <Resource name="jdbc/ShopSphere" auth="Container" type="javax.sql.DataSource"
 factory="org.apache.tomcat.dbcp.dbcp2.BasicDataSourceFactory"
 driverClassName="com.mysql.cj.jdbc.Driver"
 url="jdbc:mysql://localhost:3306/shopsphere?serverTimezone=Asia/Kolkata"
 username="shopsphere" password="CHANGE_ME" maxTotal="10" maxIdle="5"/>
</Context>
